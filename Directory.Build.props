<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>

    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>

    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>

    <NoWarn>1591</NoWarn>
    <PreferredUILang>en</PreferredUILang>
  </PropertyGroup>

  <!-- The release workflow overrides Version from the tag it builds; the value here is
       what a local build reports in the navigation rail. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <Product>Takt</Product>
    <Authors>Christian Flessa</Authors>
    <Company>Christian Flessa</Company>
    <Copyright>Copyright (c) 2026 Christian Flessa</Copyright>
    <RepositoryUrl>https://github.com/chA0s-Chris/Takt</RepositoryUrl>
  </PropertyGroup>
</Project>
