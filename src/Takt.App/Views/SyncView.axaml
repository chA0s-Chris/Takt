<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Takt.App.ViewModels"
             xmlns:views="using:Takt.App.Views"
             x:Class="Takt.App.Views.SyncView"
             x:DataType="vm:SyncViewModel">

    <UserControl.Styles>
        <Style Selector="Border.row">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.row:pointerover">
            <Setter Property="Background" Value="#F4F6FA" />
        </Style>
        <Style Selector="Border.row.pushed">
            <Setter Property="Background" Value="{StaticResource TaktRunningSoftBrush}" />
        </Style>
        <Style Selector="Border.row.failed">
            <Setter Property="Background" Value="{StaticResource TaktWarningBrush}" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,Auto,Auto,*" Margin="20,14,20,16">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Classes="title" Text="Sync" />
                <TextBlock Classes="subtle"
                           Text="Review what goes to Jira, then push. Nothing is sent automatically." />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="PushAllButton"
                    Classes="primary"
                    Content="Push all"
                    Command="{Binding PushAllCommand}"
                    IsEnabled="{Binding !IsBusy}"
                    IsVisible="{Binding !IsEmpty}"
                    VerticalAlignment="Center" />
        </Grid>

        <Border Grid.Row="1"
                Background="{StaticResource TaktWarningBrush}"
                BorderBrush="{StaticResource TaktWarningBorderBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12,9"
                Margin="0,0,0,10"
                IsVisible="{Binding IsNotConfigured}">
            <TextBlock x:Name="NotConfiguredText"
                       Classes="subtle"
                       Foreground="{StaticResource TaktWarningTextBrush}"
                       TextWrapping="Wrap"
                       Text="Jira is not configured yet — add the base URL, e-mail, and API token under Settings." />
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
            <TextBlock x:Name="StatusText"
                       Classes="subtle"
                       Text="{Binding StatusText}"
                       VerticalAlignment="Center" />
            <TextBlock Classes="muted"
                       Text="{Binding LocalOnlyText}"
                       VerticalAlignment="Center"
                       IsVisible="{Binding LocalOnlyText, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>

        <Border Grid.Row="3" Classes="card" ClipToBounds="True">
            <DockPanel>
                <TextBlock x:Name="EmptyText"
                           DockPanel.Dock="Top"
                           Classes="subtle"
                           Text="Nothing waiting — every closed entry with an issue key is in Jira."
                           Margin="14,16"
                           IsVisible="{Binding IsEmpty}" />

                <ScrollViewer>
                    <ItemsControl x:Name="DayList" ItemsSource="{Binding Days}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SyncDayGroupViewModel">
                                <StackPanel>
                                    <Grid ColumnDefinitions="*,Auto,Auto" Background="#F7F8FA">
                                        <TextBlock Grid.Column="0"
                                                   Classes="subtle"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding HeaderText}"
                                                   VerticalAlignment="Center"
                                                   Margin="14,8" />
                                        <TextBlock Grid.Column="1"
                                                   Classes="subtle"
                                                   Text="{Binding TotalText}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,8,10,8" />
                                        <Button Grid.Column="2"
                                                Classes="toolbar"
                                                Content="Push day"
                                                VerticalAlignment="Center"
                                                Margin="0,4,14,4"
                                                Command="{Binding $parent[views:SyncView].((vm:SyncViewModel)DataContext).PushDayCommand}"
                                                CommandParameter="{Binding}"
                                                IsEnabled="{Binding $parent[views:SyncView].((vm:SyncViewModel)DataContext).IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SyncRowViewModel">
                                                <Border Classes="row"
                                                        Classes.pushed="{Binding IsPushed}"
                                                        Classes.failed="{Binding HasFailed}"
                                                        BorderBrush="{StaticResource TaktRowSeparatorBrush}"
                                                        BorderThickness="0,1,0,0">
                                                    <Grid ColumnDefinitions="104,*,Auto,72,Auto"
                                                          MinHeight="46"
                                                          Margin="14,6">
                                                        <TextBlock Grid.Column="0"
                                                                   Classes="subtle"
                                                                   Text="{Binding TimeRangeText}"
                                                                   VerticalAlignment="Center" />
                                                        <StackPanel Grid.Column="1"
                                                                    Spacing="1"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,10,0">
                                                            <TextBlock Text="{Binding TaskName}"
                                                                       FontSize="13"
                                                                       TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Classes="muted"
                                                                       Text="{Binding ResultText}"
                                                                       Classes.ok="{Binding IsPushed}"
                                                                       Classes.warn="{Binding HasFailed}"
                                                                       TextWrapping="Wrap"
                                                                       IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <TextBlock Classes="muted"
                                                                       Text="{Binding StatusText}"
                                                                       IsVisible="{Binding ResultText, Converter={x:Static ObjectConverters.IsNull}}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Column="2"
                                                                    Spacing="2"
                                                                    VerticalAlignment="Center"
                                                                    Margin="0,0,10,0">
                                                            <Border Classes="chip" HorizontalAlignment="Left">
                                                                <TextBlock Text="{Binding IssueKey}" />
                                                            </Border>
                                                            <TextBlock Classes="muted"
                                                                       MaxWidth="180"
                                                                       Text="{Binding IssueSummary}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       IsVisible="{Binding IssueSummary, Converter={x:Static ObjectConverters.IsNotNull}}" />
                                                            <TextBlock Classes="muted warn"
                                                                       Text="unknown issue key"
                                                                       IsVisible="{Binding HasUnknownIssue}" />
                                                        </StackPanel>
                                                        <TextBlock Grid.Column="3"
                                                                   Classes="mono"
                                                                   Text="{Binding DurationText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0" />
                                                        <Button Grid.Column="4"
                                                                Classes="toolbar"
                                                                Content="Push"
                                                                VerticalAlignment="Center"
                                                                IsVisible="{Binding IsPushable}"
                                                                Command="{Binding $parent[views:SyncView].((vm:SyncViewModel)DataContext).PushEntryCommand}"
                                                                CommandParameter="{Binding}"
                                                                IsEnabled="{Binding $parent[views:SyncView].((vm:SyncViewModel)DataContext).IsBusy, Converter={x:Static BoolConverters.Not}}" />
                                                        <TextBlock Grid.Column="4"
                                                                   Classes="ok"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   Text="✓"
                                                                   VerticalAlignment="Center"
                                                                   HorizontalAlignment="Center"
                                                                   IsVisible="{Binding IsPushed}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
