<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Takt.App.ViewModels"
        xmlns:jira="using:Takt.Core.Jira"
        x:Class="Takt.App.Views.TemplateEditorDialog"
        x:DataType="vm:TemplateEditorViewModel"
        Icon="/Assets/takt-icon.png"
        Title="{Binding Title}"
        Width="470"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource TaktCardBrush}">

    <StackPanel Margin="20,16" Spacing="12">
        <TextBlock Classes="title" Text="{Binding Title}" />

        <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Name" />
            <TextBox x:Name="NameTextBox" Text="{Binding Name}" PlaceholderText="Meetings (Q3)" />
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Default Jira issue" />
            <StackPanel Orientation="Horizontal" Spacing="8">
                <TextBox x:Name="IssueKeyTextBox"
                         Text="{Binding IssueKey}"
                         Width="140"
                         PlaceholderText="TEAM-1234" />
                <Button x:Name="IssueSearchButton" Classes="toolbar" Content="Search…">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <StackPanel Width="300" Spacing="6">
                                <TextBox x:Name="IssueSearchTextBox"
                                         Text="{Binding IssueSearch.SearchText}"
                                         PlaceholderText="Search Jira issues…" />
                                <ItemsControl ItemsSource="{Binding IssueSearch.Results}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="jira:JiraIssueSummary">
                                            <Button HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Left"
                                                    Background="Transparent"
                                                    Padding="8,5"
                                                    Command="{Binding $parent[ItemsControl].((vm:TemplateEditorViewModel)DataContext).AssignIssueCommand}"
                                                    CommandParameter="{Binding}">
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Key}" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding Summary}"
                                                               Opacity="0.65"
                                                               MaxWidth="195"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted"
                                           Text="{Binding IssueSearch.Status}"
                                           TextWrapping="Wrap"
                                           IsVisible="{Binding IssueSearch.Status, Converter={x:Static ObjectConverters.IsNotNull}}" />
                            </StackPanel>
                        </Flyout>
                    </Button.Flyout>
                </Button>
                <Button Classes="link"
                        Content="Clear"
                        Command="{Binding ClearIssueCommand}"
                        IsVisible="{Binding IssueKey, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>
        </StackPanel>

        <StackPanel Spacing="4">
            <TextBlock Classes="label" Text="Default note" />
            <TextBox x:Name="NoteTextBox"
                     Text="{Binding Note}"
                     AcceptsReturn="True"
                     Height="60"
                     TextWrapping="Wrap" />
        </StackPanel>

        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,0">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button x:Name="DeleteButton"
                        Classes="danger"
                        Content="Delete"
                        Command="{Binding DeleteCommand}"
                        IsVisible="{Binding IsDeletable}"
                        IsEnabled="{Binding !IsDeleteConfirmationVisible}" />
                <StackPanel Orientation="Horizontal"
                            Spacing="8"
                            IsVisible="{Binding IsDeleteConfirmationVisible}">
                    <TextBlock Classes="subtle" Text="Delete for good?" VerticalAlignment="Center" />
                    <Button x:Name="ConfirmDeleteButton"
                            Classes="danger"
                            Content="Yes, delete"
                            Command="{Binding ConfirmDeleteCommand}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button Classes="toolbar"
                        Height="30"
                        Content="Cancel"
                        Command="{Binding CancelCommand}" />
                <Button x:Name="SaveButton"
                        Classes="primary"
                        Content="Save"
                        IsDefault="True"
                        Command="{Binding SaveCommand}" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
