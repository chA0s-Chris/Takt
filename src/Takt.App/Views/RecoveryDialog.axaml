<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Takt.App.Views.RecoveryDialog"
        Icon="/Assets/takt-icon.png"
        Title="Takt"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        Topmost="True">
    <StackPanel Margin="24,20" Spacing="12" MaxWidth="380">
        <TextBlock Text="A timer was still running when Takt last closed."
                   FontWeight="SemiBold" />
        <TextBlock x:Name="DetailsText" TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal"
                    Spacing="8"
                    HorizontalAlignment="Right"
                    Margin="0,8,0,0">
            <Button x:Name="StopNowButton"
                    Content="Stop now"
                    Click="OnStopNowClick" />
            <Button x:Name="ContinueButton"
                    Content="Continue tracking"
                    Classes="accent"
                    IsDefault="True"
                    Click="OnContinueClick" />
        </StackPanel>
    </StackPanel>
</Window>
